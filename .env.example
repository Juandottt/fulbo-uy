# ===== Base de datos =====
# Para Docker: usa el nombre del servicio (sqlserver)
# Para local: usa localhost\SQLEXPRESS
DB_SERVER=sqlserver
DB_NAME=FulboUY
DB_PASSWORD=TuPassword123!

# ===== JWT =====
# Cambiar por una clave aleatoria de mínimo 32 caracteres
JWT_SECRET=cambia-esto-por-una-clave-segura-minimo-32-chars
JWT_ISSUER=FulboUY
JWT_AUDIENCE=FulboUY
JWT_EXPIRATION_HOURS=24

# ===== API =====
API_PORT=5089
ASPNETCORE_ENVIRONMENT=Development

# ===== Frontend =====
VITE_API_URL=http://localhost:5089
