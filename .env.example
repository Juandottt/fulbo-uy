# Safe example values only. Do not place real secrets in this file.

# Database
DB_SERVER=localhost
DB_NAME=FulboUY
DB_USER=sa
DB_PASSWORD=change-this-local-password
CONNECTIONSTRINGS__DEFAULTCONNECTION=Server=localhost;Database=FulboUY;User Id=sa;Password=change-this-local-password;TrustServerCertificate=True;

# JWT
JWT__SECRET=replace-with-a-local-development-secret-at-least-32-characters
JWT__ISSUER=FulboUY
JWT__AUDIENCE=FulboUY
JWT__EXPIRATIONHOURS=24

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5089
API_PORT=5089

# Frontend
VITE_API_URL=http://localhost:5089
